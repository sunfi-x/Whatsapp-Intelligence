# Backend Database Configuration (SQLite default for instant local setup, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./whatsapp_ai.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_ai

# OpenAI API Configuration
OPENAI_API_KEY=sk-placeholder-key
OPENAI_MODEL=gpt-4o-mini

# Meta WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=placeholder_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=placeholder_phone_number_id
WHATSAPP_VERIFY_TOKEN=sunfi_whatsapp_verify_token_2026
WHATSAPP_API_VERSION=v22.0

# JWT Auth Security Secret
SECRET_KEY=supersecret_jwt_key_sunfi_ai_whatsapp_assistant_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
