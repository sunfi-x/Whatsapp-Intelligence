# SUNFI AI — Command Center Environment Configuration Template

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./whatsapp_ai.db

# Auth Security
SECRET_KEY=your_supersecret_jwt_key_here
ALGORITHM=HS256

# Google Gemini API Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI Configuration (Optional Fallback)
OPENAI_API_KEY=sk-placeholder-key
OPENAI_MODEL=gpt-4o-mini

# Meta WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=sunfi_whatsapp_verify_token_2026
WHATSAPP_API_VERSION=v22.0

# Frontend URL
FRONTEND_URL=http://localhost:3000
